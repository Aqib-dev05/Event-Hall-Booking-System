// Event Hall Booking System — PostgreSQL schema (Prisma 6)
//
// engineType = "client" uses Prisma's Rust-free query compiler together with
// the `pg` driver adapter (see config/db.js). No native query-engine binary needed.

generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  customer
  admin
}

enum VenueCategory {
  party
  wedding
  corporate
  birthday
  concert
  other
}

enum BookingType {
  morning
  afternoon
  evening
  fullday
}

enum BookingStatus {
  pending
  confirmed
  cancelled
  completed
}

enum PaymentStatus {
  unpaid
  paid
  refunded
}

model User {
  id            String   @id @default(uuid())
  name          String
  email         String   @unique
  password      String
  phone         String?
  role          Role     @default(customer)
  emailVerified Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  bookings Booking[]
  reviews  Review[]
}

model Venue {
  id           String        @id @default(uuid())
  name         String
  description  String
  location     String
  city         String
  capacity     Int
  pricePerHour Int
  category     VenueCategory
  images       String[]
  amenities    String[]
  isAvailable  Boolean       @default(true)
  rating       Float         @default(0)
  totalReviews Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  bookings Booking[]
  reviews  Review[]

  @@index([city, category])
  @@index([isAvailable])
  @@index([pricePerHour])
  @@index([rating])
}

model Booking {
  id              String        @id @default(uuid())
  userId          String
  venueId         String
  eventType       String
  eventDate       DateTime      @db.Date
  bookingType     BookingType
  slotLabel       String
  slotStart       String
  slotEnd         String
  durationHrs     Int
  guestCount      Int
  totalAmount     Int
  status          BookingStatus @default(pending)
  paymentStatus   PaymentStatus @default(unpaid)
  paymentIntentId String?       @unique
  specialRequests String?
  reminderSent    Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user   User    @relation(fields: [userId], references: [id])
  venue  Venue   @relation(fields: [venueId], references: [id])
  review Review?

  @@index([venueId, eventDate])
  @@index([userId, status])
  @@index([eventDate, status, reminderSent])
}

model Review {
  id        String   @id @default(uuid())
  userId    String
  venueId   String
  bookingId String   @unique
  rating    Int
  comment   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id])
  venue   Venue   @relation(fields: [venueId], references: [id])
  booking Booking @relation(fields: [bookingId], references: [id])

  @@index([venueId, createdAt])
}
