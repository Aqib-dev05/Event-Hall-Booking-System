# ── Server ───────────────────────────────────────────────
NODE_ENV=development
PORT=5000
# Browser origin(s) allowed to call this API (comma separated for several)
FRONTEND_URL=http://localhost:3000
# Timezone used for "today", reminder date and the 9 AM cron
TIMEZONE=Asia/Karachi

# ── PostgreSQL (Prisma) ──────────────────────────────────
DATABASE_URL="postgresql://postgres:password@localhost:5432/eventhall?schema=public"

# ── Auth ─────────────────────────────────────────────────
# Any long random string (min 16 chars):  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ── Stripe ───────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ── Cloudinary (venue images) ────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# All venue pictures are uploaded inside this root folder (created automatically)
CLOUDINARY_ROOT_FOLDER=event-hall-booking

# ── Email (Gmail) ────────────────────────────────────────
# Google Account -> Security -> 2-Step Verification -> App passwords
GMAIL_USER=yourname@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
# Optional: who receives "new booking" alerts (defaults to GMAIL_USER)
ADMIN_EMAIL=

# ── Cron endpoint (optional, for an external scheduler) ──
CRON_SECRET=
